# Copie este archivo como .env (no se sube a git) y complete los datos.
# Gmail: use una "contraseña de aplicación" (Cuenta de Google > Seguridad > Verificación en 2 pasos).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=su_correo@gmail.com
MAIL_PASSWORD=contraseña_de_aplicacion
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=su_correo@gmail.com

# Modo prueba (opcional): todos los correos van a esta dirección en lugar de al candidato
# MAIL_REDIRIGIR_A=su_correo@gmail.com
